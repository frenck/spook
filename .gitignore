# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# OSX useful to ignore
*.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/
.pytest_cache/

# virtualenv
.venv
venv/
ENV/

# mypy
.mypy_cache/

# ruff
.ruff_cache

# Visual Studio Code
.vscode/*

# IntelliJ Idea family of suites
.idea
*.iml

## File-based project format:
*.ipr
*.iws

## mpeltonen/sbt-idea plugin
.idea_modules/

# PyBuilder
target/

# Cookiecutter
output/
python_boilerplate/

# Node
node_modules/

# Deepcode AI
.dccache

# Screenshots and console logs of the Playwright browser tool
.playwright-mcp/

# Documentation
# The machine translations are generated, but committed: the site is built
# from them. The Cookiecutter rule above would hide them.
!documentation/translations/output/
.data/
.nuxt/
.output/
documentation/dist

# Devcontainer
config
!.vscode/tasks.json
!.vscode/launch.json

# Screenshot tool: tokens and results of the last run
documentation/screenshots/.state/

# Frontend
# Built into the integration by `npm run build` in `frontend/`, and by a
# release. Never committed.
custom_components/spook/static/
# What the development Home Assistant of `frontend/` writes down for itself.
frontend/.home-assistant/
