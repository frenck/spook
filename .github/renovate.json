{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": {
    "enabled": true
  },
  "labels": ["dependencies", "no-stale"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "commitMessagePrefix": "⬆️",
  "constraints": {
    "ghActionsLock": "v0.5.0"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep gh-actions-lock in CI and Renovate's lockfile generator on the same version",
      "managerFilePatterns": [
        "/^\\.github/workflows/actions-lock\\.yaml$/",
        "/^\\.github/renovate\\.json$/"
      ],
      "matchStrings": [
        "GH_ACTIONS_LOCK_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "\"ghActionsLock\": \"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["npm", "nvm"],
      "addLabels": ["javascript"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["npm", "nvm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "addLabels": ["python:uv"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["github/gh-actions-lock"],
      "addLabels": ["github_actions"]
    }
  ]
}
